# Copy this file to .env (for local dev) or .env.production (for a production build)
# and fill in the values. Vite only exposes vars prefixed with VITE_ to the client.

# Base URL of the backend API, including the /api prefix.
# Local dev (backend running on localhost:8000):
# VITE_API_URL=http://localhost:8000/api
# Production (deployed backend):
VITE_API_URL=https://backend.socialpilotapp.xyz/api
